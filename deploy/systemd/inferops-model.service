[Unit]
Description=InferOps model server (Ollama)
After=network-online.target
Wants=network-online.target

[Service]
User=inferops
Group=inferops
ExecStart=/usr/bin/ollama serve
Environment=HOME=/var/lib/inferops
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/var/lib/inferops/models
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
